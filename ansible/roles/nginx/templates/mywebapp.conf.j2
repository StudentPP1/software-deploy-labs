server {
    listen 80;
    access_log /var/log/nginx/mywebapp_access.log;

    location = / {
        proxy_pass http://127.0.0.1:{{ app_port }};
    }

    location /items {
        proxy_pass http://127.0.0.1:{{ app_port }};
    }

    location /health {
        proxy_pass http://127.0.0.1:{{ app_port }};
    }

    location / {
        return 403;
    }
}
